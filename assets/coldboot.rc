CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "coldboot.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "Coldboot"
			VALUE "FileVersion", "0.1.0.0"
			VALUE "ProductName", "Coldboot"
			VALUE "ProductVersion", "0.1.0.0"
			VALUE "OriginalFilename", "Coldboot.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END